generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          String   @default("MERCHANT")
  businessName  String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  products      Product[]
  orders        Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  products    Product[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Float
  stock         Int
  unit          String
  imageUrl      String?
  categoryId    String
  wholesalerId  String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  category      Category @relation(fields: [categoryId], references: [id])
  wholesaler    User     @relation(fields: [wholesalerId], references: [id])
  orderItems    OrderItem[]
  
  @@index([categoryId])
  @@index([wholesalerId])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  merchantId      String
  totalAmount     Float
  status          String   @default("PENDING")
  deliveryAddress String
  phone           String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  merchant        User       @relation(fields: [merchantId], references: [id])
  items           OrderItem[]
  
  @@index([merchantId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  price       Float
  subtotal    Float
  createdAt   DateTime @default(now())
  
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  
  @@index([orderId])
  @@index([productId])
}
